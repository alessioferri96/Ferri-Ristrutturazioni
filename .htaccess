# Redirect no-www → www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^ferriristrutturazioni\.com$ [NC]
  RewriteRule ^(.*)$ https://www.ferriristrutturazioni.com/$1 [R=301,L]
</IfModule>

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Blocca i file di servizio/build già presenti sul server.
# Sono esclusi dal deploy, ma l'action non cancella i file esclusi:
# li rende solo non aggiornabili. Quindi si nega l'accesso.
<FilesMatch "^(package(-lock)?\.json|input\.css|tailwind\.config\.js|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

# Redirect /index.html to / for canonical consistency
<IfModule mod_rewrite.c>
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Compressione GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache Browser
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security Headers
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.iubenda.com embeds.iubenda.com idb.iubenda.com unpkg.com; style-src 'self' 'unsafe-inline' cdn.iubenda.com unpkg.com; img-src 'self' data: cdn.iubenda.com www.gstatic.com unpkg.com tile.openstreetmap.org; font-src 'self'; frame-src 'self' www.iubenda.com; connect-src 'self' idb.iubenda.com cpl.iubenda.com; object-src 'none'"
</IfModule>
